# Copy to .env.local and adjust. Every variable is optional.

# Where the SQLite database and screenshots are stored (default: ./data)
SCAPER_DATA_DIR=./data

# Set a password to require login (recommended before you put Scaper on a VPS).
# Leave empty for local-only use on 127.0.0.1.
SCAPER_APP_PASSWORD=

# Secret used to sign the login cookie. Required when SCAPER_APP_PASSWORD is set.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCAPER_SESSION_SECRET=

# Use an already installed Chrome/Chromium instead of the Playwright download.
PLAYWRIGHT_EXECUTABLE_PATH=

# Turn the background scheduler off (for example when running tests). Default: on
SCAPER_SCHEDULER=on

# Comma-separated host names allowed to reach the app (protects against DNS rebinding).
# localhost and 127.0.0.1 are always allowed. Add your domain when you deploy, e.g. scaper.example.com
SCAPER_ALLOWED_HOSTS=
